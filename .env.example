# ============================================================
# Plantilla de variables de entorno para HaulageBot2.0
# Copiar a ".env" y ajustar los valores según el servidor.
#   cp .env.example .env
# ============================================================

# Puerto en el que se expone el bot en el host
HOST_PORT=1254

# Entorno de ejecución: Production o Development
ASPNETCORE_ENVIRONMENT=Production

# Cadena de conexión a la base de datos SQLite (persistida en el volumen /data)
DB_CONNECTION=Data Source=/data/haulage_bot.db

# Configuración de autenticación contra SmartFlow
AUTH_API_URL=https://demo-acarreos.smartflow.com.mx
AUTH_CLIENT_ID=private.networking.app
AUTH_CLIENT_SECRET=UxwYJsELeTnSc2Zz642K

# Ajuste de zona horaria (horas a restar). México (CST) = -6
TIMEZONE_OFFSET_HOURS=-6
