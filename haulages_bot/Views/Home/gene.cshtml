            </div>
            <div class="modal-footer">
                <button type="button" class="px-4 py-2 bg-slate-950/40 border border-slate-800 text-slate-400 font-cyber-title font-bold text-[11px] rounded hover:bg-slate-900/60 hover:text-slate-200 hover:border-slate-700 transition-all" data-bs-dismiss="modal">Descartar</button>
                <button type="button" class="px-6 py-2 bg-[#0a5da7] text-white font-cyber-title font-bold text-[11px] rounded" id="btnSubmitCorrected" onclick="submitCorrectedRows()">Importar Corregidos</button>
            </div>
        </div>
    </div>
</div>

