<?xml version="1.0" encoding="utf-8"?>
<configuration>
 <packageSources>
  <clear />
  <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  <add key="GitlabGroup" value="https://developer.lasec.com.mx/api/v4/groups/4/-/packages/nuget/index.json" />
 </packageSources>
 <packageSourceCredentials>
    <GitlabGroup>
      <add key="Username" value="%GITLAB_USERNAME%" />
      <add key="ClearTextPassword" value="%GTILAB_JOB_TOKEN%" />
    </GitlabGroup>
  </packageSourceCredentials>
</configuration>
