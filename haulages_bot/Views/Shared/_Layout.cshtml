<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Smartflow Multi-Bot</title>

    <!-- Tailwind CSS (local) -->
    <script src="~/lib/tailwind.min.js"></script>
    <script>
        tailwind.config = {
            important: true
        }
    </script>
    
    <!-- Google Fonts (graceful degradation - falls back to system fonts if offline) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Orbitron:wght@600;700;900&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 CSS (local) -->
    <link href="~/lib/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Flatpickr Date Picker (local) -->
    <link rel="stylesheet" href="~/lib/flatpickr-dark.css" />

    <style>
        :root {
            --bg:       #111113;
            --bg-2:     #18181b;
            --bg-3:     #1f1f23;
            --bg-4:     #27272a;
            --border:       rgba(255, 255, 255, 0.08);
            --border-light: rgba(255, 255, 255, 0.12);
            --border-glow:  rgba(161, 161, 170, 0.25);
            --text:       #f0f0f2;
            --text-muted: #a1a1aa;
            --text-dim:   #63636e;
            /* Toned-down palette — materiales mantienen color */
            --neon-cyan:   #6bb8cc;
            --neon-blue:   #5b8fd9;
            --neon-purple: #9b7cd4;
            --neon-pink:   #e05a7a;
            --neon-green:  #4eba8a;
            --neon-yellow: #d4b84a;
            --accent:        var(--neon-blue);
            --accent-dim:    rgba(91, 143, 217, 0.1);
            --accent-border: rgba(91, 143, 217, 0.25);
            --danger:  var(--neon-pink);
            --success: var(--neon-green);
            --warning: var(--neon-yellow);
            /* Subtle glow helpers (reduced intensity) */
            --glow-cyan:   0 0 8px rgba(107, 184, 204, 0.2);
            --glow-blue:   0 0 8px rgba(91, 143, 217, 0.2);
            --glow-green:  0 0 8px rgba(78, 186, 138, 0.2);
            --glow-pink:   0 0 8px rgba(224, 90, 122, 0.2);
            --glow-purple: 0 0 8px rgba(155, 124, 212, 0.2);
            --sidebar-w: 220px;
            --header-h: 56px;
        }

        * { box-sizing: border-box; }

        /* Global override to prevent Bootstrap's .border from applying high-contrast light borders on dark theme */
        .border {
            border-color: rgba(100, 160, 255, 0.12) !important;
        }

        body {
            background: var(--bg) !important;
            color: var(--text) !important;
            font-family: 'Inter', sans-serif !important;
            margin: 0;
            overflow: hidden;
        }

        /* === SCROLLBAR === */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); border-radius: 3px; }
        ::-webkit-scrollbar-thumb { background: rgba(0, 212, 255, 0.25); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(0, 212, 255, 0.45); }

        /* === HEADER === */
        #app-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: var(--header-h);
            background: rgba(17, 17, 19, 0.97);
            border-bottom: 1px solid var(--border);
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            z-index: 100;
            backdrop-filter: blur(16px);
        }

        /* Subtle top-line */
        #app-header::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, var(--neon-blue), var(--neon-cyan), var(--neon-purple));
            opacity: 0.4;
        }

        .header-brand {
            font-family: 'Orbitron', sans-serif;
            font-size: 12px;
            font-weight: 700;
            color: #f0f0f2;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        /* Timer widget in header */
        .timer-widget {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 5px 14px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            transition: border-color 0.2s;
        }

        .timer-widget:hover { border-color: var(--border-light); }
        .timer-widget .label { color: var(--text-muted); }
        .timer-widget .time-val { color: var(--neon-cyan); font-weight: 600; }

        .timer-badge {
            background: rgba(91, 143, 217, 0.1);
            color: var(--neon-blue);
            border: 1px solid rgba(91, 143, 217, 0.2);
            border-radius: 6px;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .timer-badge.inactive {
            background: rgba(255,255,255,0.03);
            color: var(--text-muted);
            border-color: var(--border);
        }

        /* === SIDEBAR === */
        #app-sidebar {
            position: fixed;
            top: var(--header-h);
            left: 0;
            width: var(--sidebar-w);
            height: calc(100vh - var(--header-h));
            background: var(--bg-2);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 20px 0 16px;
            z-index: 90;
        }

        .sidebar-section-label {
            font-size: 9px;
            font-weight: 700;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 0 16px;
            margin-bottom: 8px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 16px;
            margin: 1px 8px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-muted);
            text-decoration: none;
            transition: all 0.18s ease;
            cursor: pointer;
            border: 1px solid transparent;
            position: relative;
        }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.04);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.08);
            text-decoration: none;
        }

        .nav-item.active {
            background: rgba(91, 143, 217, 0.08);
            color: var(--neon-cyan);
            border: 1px solid rgba(91, 143, 217, 0.18);
        }

        .nav-item .material-symbols-outlined {
            font-size: 18px;
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
        }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 12px 16px;
        }

        /* Add server button in sidebar */
        .sidebar-add-btn {
            margin: 8px 10px 0;
            padding: 9px 14px;
            background: rgba(78, 186, 138, 0.05);
            border: 1px dashed rgba(78, 186, 138, 0.3);
            border-radius: 10px;
            color: var(--neon-green);
            font-size: 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.2s;
            text-align: left;
        }

        .sidebar-add-btn:hover {
            background: rgba(78, 186, 138, 0.1);
            border-color: rgba(78, 186, 138, 0.5);
        }

        /* Terminal in sidebar */
        .sidebar-terminal {
            margin: auto 10px 0;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--border);
            border-left: 2px solid var(--neon-pink);
            border-radius: 10px;
            overflow: hidden;
        }

        .sidebar-terminal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 7px 10px;
            border-bottom: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.02);
        }

        .sidebar-terminal-title {
            font-size: 9px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .sidebar-terminal-clear {
            font-size: 10px;
            color: var(--text-dim);
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            transition: color 0.15s;
        }

        .sidebar-terminal-clear:hover { color: var(--neon-pink); }

        .sidebar-terminal-log {
            height: 160px;
            overflow-y: auto;
            padding: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            color: var(--text-muted);
            line-height: 1.5;
            scrollbar-width: thin;
            scrollbar-color: rgba(0, 212, 255, 0.2) transparent;
        }

        .sidebar-terminal-log::-webkit-scrollbar { width: 4px; }
        .sidebar-terminal-log::-webkit-scrollbar-thumb { background: rgba(0, 212, 255, 0.2); border-radius: 2px; }

        /* === MAIN CONTENT === */
        #app-main {
            margin-left: var(--sidebar-w);
            margin-top: var(--header-h);
            height: calc(100vh - var(--header-h));
            overflow-y: auto;
            padding: 28px 32px;
            background: transparent;
        }

        /* === CARDS === */
        .card-dark {
            background: var(--bg-2);
            border: 1px solid var(--border);
            border-radius: 14px;
        }

        /* === MODAL OVERRIDES === */
        .modal-content {
            background: var(--bg-3) !important;
            border: 1px solid var(--border-light) !important;
            color: var(--text) !important;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7) !important;
        }

        .modal-header {
            border-bottom: 1px solid var(--border) !important;
            padding: 18px 22px !important;
        }

        .modal-footer {
            border-top: 1px solid var(--border) !important;
            padding: 14px 22px !important;
        }

        .modal-title {
            font-size: 13px !important;
            font-weight: 700 !important;
            color: var(--text) !important;
            letter-spacing: 0.5px;
        }

        .btn-close {
            filter: invert(1) brightness(0.65);
        }

        /* === STATUS DOTS === */
        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }

        .status-dot.online  { background: var(--neon-green); }
        .status-dot.offline { background: var(--neon-pink); }
        .status-dot.running {
            background: var(--neon-green);
            animation: pulse-dot 2s ease-in-out infinite;
        }
        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* === CYBER INPUT === */
        .cyber-input {
            background: rgba(0, 0, 0, 0.3) !important;
            border: 1px solid var(--border-light) !important;
            color: var(--text) !important;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            transition: all 0.2s ease;
        }

        .cyber-input:focus {
            border-color: var(--neon-cyan) !important;
            box-shadow: 0 0 0 2px rgba(107, 184, 204, 0.12) !important;
            outline: none !important;
            background: rgba(255, 255, 255, 0.03) !important;
        }

        .cyber-input::placeholder { color: var(--text-dim) !important; font-size: 12px; }

        /* Remove number input spinners */
        #globalTimezoneOffsetInput::-webkit-outer-spin-button,
        #globalTimezoneOffsetInput::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        #globalTimezoneOffsetInput {
            -moz-appearance: textfield;
        }

        /* === TERMINAL SCROLLBARS === */
        .terminal-scroll::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        .terminal-scroll::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.25);
            border-radius: 4px;
        }
        .terminal-scroll::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .terminal-scroll::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.35);
        }
        .terminal-scroll {
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.2) rgba(0, 0, 0, 0.25);
        }

        /* === FONT HELPERS === */
        .font-cyber-title { font-family: 'Inter', sans-serif; font-weight: 700; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }

        /* === NOTIFICATIONS === */
        .loading-screen-refresh {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            background-color: rgba(12, 12, 12, 0.95);
            z-index: 9999;
            display: flex;
        }

        /* === USER INFO === */
        .user-tag {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            background: rgba(100, 160, 255, 0.06);
            border: 1px solid var(--border);
            padding: 3px 10px;
            border-radius: 6px;
        }

        .logout-btn {
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            padding: 6px;
            border-radius: 8px;
            width: 32px; height: 32px;
        }

        .logout-btn:hover {
            color: var(--neon-pink);
            border-color: rgba(224, 90, 122, 0.3);
            background: rgba(224, 90, 122, 0.08);
        }
    </style>

    <!-- jQuery, Bootstrap, SignalR JS (local) -->
    <script src="~/lib/jquery-3.5.1.min.js"></script>
    <script src="~/lib/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr.min.js"></script>
</head>
<body>

    <!-- Notification Toast Container -->
    <div id="notification-container" style="position: fixed; top: 70px; right: 20px; z-index: 1050; max-width: 340px;"></div>

    <!-- Notification Sound -->
    <audio id="notification-sound" src="/audio/NotificationExample.mp3" preload="auto"></audio>

    <!-- ===== HEADER ===== -->
    <header id="app-header">
        <span class="header-brand">Smartflow Multi-Bot</span>

        <div class="header-right">
            <!-- Timer widget -->
            <div id="navbar-timer-widget" class="timer-widget">
                <span class="material-symbols-outlined" style="font-size:15px;color:var(--text-muted);">schedule</span>
                <span class="label">Próxima:</span>
                <span id="navNextRunText" class="time-val">--:--:--</span>
                <span id="navCountdownText" class="timer-badge inactive">Desactivado</span>
            </div>

            <div style="width:1px;height:24px;background:var(--border);"></div>

            <span class="user-tag">@Context.Request.Cookies["Username"]</span>

            <form asp-controller="Authentication" asp-action="Logout" method="post" id="logoutForm" style="display:none;"></form>
            <button onclick="document.getElementById('logoutForm').submit(); return false;" class="logout-btn" title="Cerrar Sesión">
                <span class="material-symbols-outlined" style="font-size:18px;">logout</span>
            </button>
        </div>
    </header>

    <!-- ===== SIDEBAR ===== -->
    <aside id="app-sidebar">
        <div class="sidebar-section-label">Principal</div>
        <nav>
            <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "gene" ? "active" : "")" href="~/Home/gene">
                <span class="material-symbols-outlined">smart_toy</span>
                Bot Acarreos
            </a>
        </nav>

        <div class="sidebar-divider"></div>
        <div class="sidebar-section-label">Configuración</div>
        <nav style="margin-bottom: 12px;">
            <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "servers" ? "active" : "")" href="~/Home/servers">
                <span class="material-symbols-outlined">dns</span>
                Servidores
            </a>
            <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Logs" ? "active" : "")" href="~/Home/Logs">
                <span class="material-symbols-outlined">receipt_long</span>
                System Logs
            </a>
        </nav>

        <div style="padding: 0 16px; margin-bottom: 16px;">
            <div style="font-size: 10px; font-weight: 700; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px;">Ajuste Horario</div>
            <div style="display: flex; align-items: center; gap: 8px; background: var(--bg-3); border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px;">
                <span class="material-symbols-outlined" style="font-size:16px;color:var(--text-muted);">schedule</span>
                <input type="number" id="globalTimezoneOffsetInput" class="form-control-sm bg-transparent text-light border-0" style="width: 100%; font-size: 13px; outline: none; padding: 0; box-shadow: none;" placeholder="Horas" value="0">
                <span style="font-size: 11px; color: var(--text-muted); font-weight: 600;">hrs</span>
            </div>
        </div>

        <button onclick="location.href='/Home/servers?add=true'" class="sidebar-add-btn">
            <span class="material-symbols-outlined" style="font-size:16px;">add</span>
            Agregar Servidor
        </button>

        <!-- Mini terminal en el sidebar -->
        <div class="sidebar-terminal" style="margin-top:12px;">
            <div class="sidebar-terminal-header">
                <span class="sidebar-terminal-title" id="sidebarTerminalTitle">LOGS: ACTIVE</span>
                <button class="sidebar-terminal-clear" onclick="clearSidebarTerminal()">Limpiar</button>
            </div>
            <div class="sidebar-terminal-log terminal-scroll" id="sidebarTerminalLog">
                <p style="color:var(--text-dim);">[Sistema] Listo. Selecciona un servidor para ver sus logs en tiempo real.</p>
            </div>
        </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <main id="app-main">
        @RenderBody()
    </main>

    <!-- Screen overlay for processing/loading -->
    <div id="loading-screen-refresh" class="loading-screen-refresh flex-col items-center justify-center" style="display: none;">
        <!-- Barra de progreso superior -->
        <div class="w-full h-0.5 bg-white/5 absolute top-0">
            <div class="h-full bg-blue-500 animate-[pulse_1.5s_infinite]" style="width: 100%;"></div>
        </div>
        <!-- Spinner en el centro -->
        <div class="spinner-border" role="status" style="width: 2.5rem; height: 2.5rem; color: var(--accent);">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p style="color:var(--accent);font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-top:16px;">Cargando recursos...</p>
    </div>

    <!-- Scripts setup -->
    <script>
        $(document).ready(function () {
            $('#loading-screen-refresh').fadeOut(400);
            updateHeaderServerName();

            window.addEventListener('storage', function(e) {
                if (e.key === 'activeServerName') {
                    updateHeaderServerName();
                }
            });
        });

        function updateHeaderServerName() {
            var activeName = localStorage.getItem('activeServerName') || "Sin Seleccionar";
            var activeServerId = localStorage.getItem('activeServerId');
            $('#sidebarTerminalTitle').text("LOGS: " + activeName.toUpperCase());
            if (activeServerId) {
                fetchSidebarLogHistory(activeServerId);
            } else {
                $('#sidebarTerminalLog').html('<p style="color:var(--text-dim);">[Sistema] Listo. Selecciona un servidor para ver sus logs en tiempo real.</p>');
            }
        }

        function fetchSidebarLogHistory(serverId) {
            $.get(`/api/sync/logHistory?serverId=${serverId}`, function(logs) {
                const container = $('#sidebarTerminalLog');
                container.empty();
                if (logs && logs.length > 0) {
                    logs.forEach(function(log) {
                        const time = new Date(log.timestamp || log.Timestamp);
                        const timeStr = time.toLocaleTimeString();
                        const message = log.message || log.Message;
                        const isError = log.isError || log.IsError;
                        const color = isError ? 'var(--danger)' : 'var(--text-muted)';
                        const line = `<p style="margin-bottom:2px;color:${color};">[${timeStr}] ${message}</p>`;
                        container.append(line);
                    });
                    container.scrollTop(container[0].scrollHeight);
                } else {
                    container.html('<p style="color:var(--text-dim);">[Consola vacía para este servidor]</p>');
                }
            });
        }

        function clearSidebarTerminal() {
            const activeServerId = localStorage.getItem('activeServerId');
            $('#sidebarTerminalLog').html('<p style="color:var(--text-dim);">[Terminal Limpia]</p>');
            if (activeServerId) {
                $.post(`/api/sync/clearLogHistory?serverId=${activeServerId}`);
            }
        }

        function appendSidebarTerminal(message, isError) {
            const container = $('#sidebarTerminalLog');
            const now = new Date();
            const timeStr = now.toLocaleTimeString();
            const color = isError ? 'var(--danger)' : 'var(--text-muted)';
            const line = `<p style="margin-bottom:2px;color:${color};">[${timeStr}] ${message}</p>`;
            container.append(line);
            container.scrollTop(container[0].scrollHeight);
            const lines = container.find('p');
            if (lines.length > 5000) lines.first().remove();
        }

        window.addEventListener("ServerNotification", function(e) {
            const payload = e.detail;
            if (!payload) return;
            const activeServerId = localStorage.getItem('activeServerId');
            if (typeof payload === 'object') {
                const sId = payload.serverId || payload.ServerId;
                const message = payload.message || payload.Message;
                const isError = payload.error || payload.Error;
                if (sId == activeServerId) appendSidebarTerminal(message, isError);
            } else if (typeof payload === 'string') {
                appendSidebarTerminal(payload, false);
            }
        });
    </script>

    <!-- Flatpickr JS (local) -->
    <script src="~/lib/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr-es.js"></script>

    <!-- Custom layout execution and SignalR -->
    <script src="~/js/layout.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
