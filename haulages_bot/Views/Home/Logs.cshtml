@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "System Logs";
}

<style>
    .font-cyber-title {
        font-family: 'Inter', sans-serif;
    }
</style>

<div class="container-fluid py-4">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="font-cyber-title text-2xl font-bold tracking-tight text-white">
                <span class="material-symbols-outlined text-[#36b0c9] mr-2 text-3xl">receipt_long</span> SYSTEM LOGS
            </h2>
            <p class="text-slate-300 text-sm mt-1 font-medium">Consolas de registro en vivo independientes para cada servidor y bot configurado.</p>
        </div>
        <button class="px-6 py-2.5 bg-slate-950/40 border border-slate-800 text-slate-300 font-cyber-title text-[11px] font-bold rounded-md hover:bg-slate-900/60 hover:text-white hover:border-slate-700 transition-all" onclick="clearAllLogs()">
            LIMPIAR TODAS LAS CONSOLAS
        </button>
    </div>

    <!-- Grid de consolas por servidor -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="terminalsGrid">
        <div class="col-span-2 text-center py-12">
            <span class="text-slate-400 opacity-50 small">Cargando consolas de registro...</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let configuredServers = [];

        $(document).ready(function() {
            loadServerTerminals();
        });

        function loadServerTerminals() {
            $.get('/api/ServerConfig', function(servers) {
                configuredServers = servers;
                $('#terminalsGrid').empty();

                if (servers.length === 0) {
                    $('#terminalsGrid').append(`
                        <div class="col-span-2 text-center py-12 bg-black/30 border border-slate-900 rounded-lg">
                            <p class="text-slate-400 font-medium">No hay servidores registrados para monitorear.</p>
                        </div>
                    `);
                    return;
                }

                servers.forEach(function(server) {
                    const statusClass = server.isBotRunning ? 'bg-[#22c55e]' : 'bg-slate-500';
                    const panel = `
                        <div class="cyber-card rounded-lg p-6 flex flex-col h-[450px]" id="terminal-card-${server.id}">
                            <div class="flex items-center justify-between mb-4 border-b border-slate-900 pb-3">
                                <div class="flex items-center gap-2">
                                    <span class="status-dot ${statusClass}" id="terminal-dot-${server.id}"></span>
                                    <h3 class="font-cyber-title text-base font-bold text-white uppercase tracking-wider">${server.name}</h3>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="text-[10px] font-mono text-slate-400">${server.apiUrl}</span>
                                    <button class="text-[11px] text-slate-500 hover:text-red-500 transition-colors" onclick="clearServerLog(${server.id})">Limpiar</button>
                                </div>
                            </div>
                            <div class="flex-1 font-mono text-[12px] overflow-y-auto terminal-scroll p-4 bg-black/55 rounded border border-white/5 text-slate-200" id="terminal-log-${server.id}">
                                <p class="mb-1 text-slate-500 font-mono">[Sistema] Consola iniciada. Escuchando eventos para el servidor...</p>
                            </div>
                        </div>
                    `;
                    $('#terminalsGrid').append(panel);
                    fetchLogHistory(server.id);
                });
            });
        }

        function fetchLogHistory(serverId) {
            $.get(`/api/sync/logHistory?serverId=${serverId}`, function(logs) {
                const container = $(`#terminal-log-${serverId}`);
                if (container.length === 0) return;
                
                if (logs && logs.length > 0) {
                    container.empty();
                    logs.forEach(function(log) {
                        const time = new Date(log.timestamp || log.Timestamp);
                        const timeStr = time.toLocaleTimeString();
                        const message = log.message || log.Message;
                        const isError = log.isError || log.IsError;
                        const textClass = isError ? 'text-red-500 font-bold' : 'text-slate-300';
                        const line = `<p class="mb-1 ${textClass}">[${timeStr}] ${message}</p>`;
                        container.append(line);
                    });
                    container.scrollTop(container[0].scrollHeight);
                }
            });
        }

        function clearServerLog(serverId) {
            $(`#terminal-log-${serverId}`).html('<p class="mb-1 text-slate-600 font-mono">[Consola Limpiada]</p>');
            $.post(`/api/sync/clearLogHistory?serverId=${serverId}`);
        }

        function clearAllLogs() {
            configuredServers.forEach(server => clearServerLog(server.id));
        }

        function appendServerLog(serverId, message, isError) {
            const container = $(`#terminal-log-${serverId}`);
            if (container.length === 0) return;

            const now = new Date();
            const timeStr = now.toLocaleTimeString();
            const textClass = isError ? 'text-red-500 font-bold' : 'text-slate-300';

            const line = `<p class="mb-1 ${textClass}">[${timeStr}] ${message}</p>`;
            container.append(line);

            // Auto-scroll
            container.scrollTop(container[0].scrollHeight);

            // Control de líneas máximas en consola
            const lines = container.find('p');
            if (lines.length > 5000) {
                lines.first().remove();
            }
        }

        window.addEventListener("ServerNotification", function(e) {
            const payload = e.detail;
            if (!payload) return;

            if (typeof payload === 'object') {
                const sId = payload.serverId || payload.ServerId;
                const message = payload.message || payload.Message;
                const isError = payload.error || payload.Error;

                if (sId) {
                    appendServerLog(sId, message, isError);
                }
            }
        });
    </script>
}
