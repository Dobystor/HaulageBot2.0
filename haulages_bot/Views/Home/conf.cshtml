@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Configuracion</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />

    <!-- Referencias a scripts externos -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.6/js/dx.all.js"></script>
    <script src="https://unpkg.com/devextreme-aspnet-data@3.0.0/js/dx.aspnet.dgene.js"></script>
    <script src="https://unpkg.com/devextreme-aspnet-data@3.0.0/js/dx.aspnet.data.js"></script>
    <script src="~/js/conf.js"></script> <!-- Aquí es donde se carga el archivo conf.js desde la carpeta js -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.7/signalr.min.js"></script>

    <!-- Referencias a hojas de estilo externas y locales -->
    <link rel="stylesheet" type="text/css" href="https://cdn3.devexpress.com/jslib/23.2.6/css/dx.material.blue.light.css" />
    <link rel="stylesheet" type="text/css" href="~/css/conf.css?v=1.0" /> <!-- Aquí se carga el archivo conf.css desde la carpeta css -->
</head>
<body>
    
    <div class="main-content">
        <!-- Título -->
        <div class="column-header">Configuración del Bot</div>

        <!-- Contenido -->
        <div class="grid-container">
            <!-- Tonelaje -->
            <div class="text-cell">
                <span class="cell-title">Tonelaje:</span>
                <span class="info-icon" data-bs-toggle="tooltip" title="Define el rango de variación del tonelaje del -30 al 10% solo se aceptan datos como 3-10%, -10--2, -5-10 otro como 5----4 no es posible utilizar.">?</span>
                <div id="text3"></div>
            </div>

            <!-- Tiempo -->
            <div class="text-cell">
                <span class="cell-title">Tiempo:</span>
                <span class="info-icon" data-bs-toggle="tooltip" title="Define un rango de tiempo de entre 1 a 60 minutos, solo se acepta datos como 1-59 min otros como -5--60 o 8---9 no son posibles de utilizar.">?</span>
                <div id="text4"></div>
            </div>

            <!-- Ruta -->
            <div class="text-cell">
                <label class="cell-title">Ruta</label>
                <span class="info-icon" data-bs-toggle="tooltip" title="Selecciona una o varias rutas que necesites.">?</span>
                <div id="ruta"></div>
            </div>

            <!-- Empleados -->
            <div class="text-cell">
                <label class="cell-title">Empleados</label>
                <span class="info-icon" data-bs-toggle="tooltip" title="Selecciona los empleados que necesites.">?</span>
                <div id="employeeDropdown"></div>
            </div>

            <!-- Vehículos -->
            <div class="text-cell">
                <label class="cell-title">Vehículos</label>
                <span class="info-icon" data-bs-toggle="tooltip" title="Selecciona los vehículos que necesites.">?</span>
                <div id="vehicleDropdown"></div>
            </div>
        </div>

        <!-- Botón Guardar -->
        <div class="btn-conf" id="button2"></div>
    </div>


    

</body>
</html>
