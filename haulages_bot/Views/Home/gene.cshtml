@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Bot de Acarreos";
}

<!-- Custom Styles for Page Components -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.2/font/bootstrap-icons.css" />
<link rel="stylesheet" href="~/css/gene.css" asp-append-version="true" />

<style>
    /* Legacy aliases for compatibility */
    :root {
        --accent-teal: var(--neon-cyan);
        --accent: var(--neon-blue);
        --accent-dim: rgba(30, 111, 255, 0.1);
    }

    .font-cyber-title { font-family: 'Inter', sans-serif; }

    /* Beautiful, compact checkbox lists */
    .checkbox-item {
        display: flex;
        align-items: flex-start !important;
        gap: 6px !important;
        padding: 4px 6px !important;
        border-radius: 5px !important;
        transition: background 0.15s ease-in-out !important;
        font-size: 10px !important;
        font-weight: 500 !important;
        cursor: pointer !important;
        background: transparent !important;
    }
    .checkbox-item:hover {
        background: rgba(0, 212, 255, 0.05) !important;
    }
    .checkbox-item label {
        font-size: 10px !important;
        line-height: 1.35 !important;
        cursor: pointer !important;
        margin: 0 !important;
        flex: 1 !important;
        word-break: break-word !important;
        color: var(--text-muted);
        transition: color 0.15s ease-in-out !important;
    }
    .checkbox-item label.fs-small {
        font-size: 8.2px !important;
        line-height: 1.25 !important;
    }
    .checkbox-item label.fs-medium {
        font-size: 9.2px !important;
        line-height: 1.3 !important;
    }
    .checkbox-item label.fs-normal {
        font-size: 10px !important;
        line-height: 1.35 !important;
    }
    .checkbox-item label .item-id {
        font-size: 8.5px !important;
        font-family: 'JetBrains Mono', monospace !important;
        color: var(--text-muted) !important;
        opacity: 0.7;
        margin-left: 4px !important;
    }
    .checkbox-item input[type="checkbox"]:checked + label {
        color: var(--neon-cyan) !important;
        font-weight: 600 !important;
    }
    .checkbox-item input[type="checkbox"] {
        accent-color: var(--neon-cyan) !important;
        width: 12px !important;
        height: 12px !important;
        margin-top: 2px !important;
        cursor: pointer !important;
        flex-shrink: 0 !important;
    }

    /* Specific alignments to keep checkboxes perfectly aligned */
    #employeesList .checkbox-item,
    #vehiclesList .checkbox-item {
        align-items: center !important;
    }
    #employeesList .checkbox-item input[type="checkbox"],
    #vehiclesList .checkbox-item input[type="checkbox"] {
        margin-top: 0 !important;
    }

    #routesList .checkbox-item {
        align-items: flex-start !important;
    }
    #routesList .checkbox-item input[type="checkbox"] {
        margin-top: 1.5px !important;
    }

    /* Route / Material filter buttons */
    .route-mat-btn {
        color: var(--text-muted) !important;
        border: 1px solid rgba(100, 160, 255, 0.15) !important;
        background: rgba(255, 255, 255, 0.02) !important;
        transition: all 0.15s ease !important;
        cursor: pointer;
        border-radius: 8px !important;
        font-size: 11px !important;
        font-weight: 700 !important;
    }
    .route-mat-btn:hover { opacity: 0.85; }
    .route-mat-btn[data-mat="1"] {
        color: #ffd700 !important;
        border: 1px solid rgba(255, 215, 0, 0.25) !important;
        background: rgba(255, 215, 0, 0.04) !important;
    }
    .route-mat-btn[data-mat="2"] {
        color: #ff6432 !important;
        border: 1px solid rgba(255, 100, 50, 0.25) !important;
        background: rgba(255, 100, 50, 0.04) !important;
    }
    .route-mat-btn[data-mat="3"] {
        color: #00c8b4 !important;
        border: 1px solid rgba(0, 200, 180, 0.25) !important;
        background: rgba(0, 200, 180, 0.04) !important;
    }

    .route-mat-btn.active[data-mat="all"] {
        color: var(--neon-blue) !important;
        border-color: rgba(30,111,255,0.5) !important;
        background: rgba(30,111,255,0.15) !important;
    }
    .route-mat-btn.active[data-mat="1"] {
        color: var(--neon-yellow) !important;
        border-color: rgba(255,233,77,0.5) !important;
        background: rgba(255,233,77,0.12) !important;
    }
    .route-mat-btn.active[data-mat="2"] {
        color: var(--neon-pink) !important;
        border-color: rgba(255,60,110,0.5) !important;
        background: rgba(255,60,110,0.12) !important;
    }
    .route-mat-btn.active[data-mat="3"] {
        color: var(--neon-green) !important;
        border-color: rgba(0,232,150,0.5) !important;
        background: rgba(0,232,150,0.12) !important;
    }

    /* Custom secondary & danger buttons to avoid high contrast white borders */
    .btn-secondary-custom {
        background: rgba(15, 23, 42, 0.45) !important;
        border: 1px solid rgba(100, 160, 255, 0.15) !important;
        color: var(--text-muted) !important;
        transition: all 0.2s ease !important;
        cursor: pointer;
    }
    .btn-secondary-custom:hover {
        background: rgba(100, 160, 255, 0.1) !important;
        border-color: rgba(100, 160, 255, 0.3) !important;
        color: #ffffff !important;
    }
    .btn-danger-custom {
        background: rgba(239, 68, 68, 0.05) !important;
        border: 1px solid rgba(239, 68, 68, 0.2) !important;
        color: #f87171 !important;
        transition: all 0.2s ease !important;
        cursor: pointer;
    }
    .btn-danger-custom:hover {
        background: rgba(239, 68, 68, 0.15) !important;
        border-color: rgba(239, 68, 68, 0.45) !important;
        color: #ffffff !important;
    }

    /* Inputs matching new system */
    .cyber-input {
        background: rgba(8, 16, 32, 0.8) !important;
        border: 1px solid rgba(100, 160, 255, 0.2) !important;
        color: var(--text) !important;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 500;
        transition: all 0.2s ease;
        border-radius: 8px;
    }
    .cyber-input:focus {
        border-color: var(--neon-cyan) !important;
        box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1), 0 0 16px rgba(0, 212, 255, 0.3) !important;
        outline: none !important;
        background: rgba(0, 212, 255, 0.02) !important;
    }

    /* Remove native spinners */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type="number"] { -moz-appearance: textfield; }

    /* Fix Flatpickr altInput padding */
    .date-input-wrapper input { padding-left: 2.5rem !important; }

    /* Custom premium dark/neon Flatpickr style overrides */
    .flatpickr-calendar {
        background: var(--bg-3) !important;
        border: 1px solid var(--border) !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
        border-radius: 12px !important;
        font-family: 'Inter', sans-serif !important;
    }
    .flatpickr-calendar.arrowTop:before {
        border-bottom-color: rgba(0, 240, 255, 0.3) !important;
    }
    .flatpickr-calendar.arrowTop:after {
        border-bottom-color: rgba(13, 20, 35, 0.95) !important;
    }
    .flatpickr-months {
        background: transparent !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        padding-bottom: 6px !important;
    }
    .flatpickr-month {
        color: #ffffff !important;
    }
    .flatpickr-current-month {
        font-family: 'Inter', sans-serif !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        color: #ffffff !important;
        font-size: 13px !important;
    }
    .flatpickr-monthDropdown-months {
        color: #ffffff !important;
        background: #0d1423 !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 4px !important;
        padding: 2px 6px !important;
    }
    .flatpickr-current-month .numInputWrapper span.arrowUp:after {
        border-bottom-color: #ffffff !important;
    }
    .flatpickr-current-month .numInputWrapper span.arrowDown:after {
        border-top-color: #ffffff !important;
    }
    .flatpickr-weekday {
        color: var(--accent-teal) !important;
        font-family: 'Inter', sans-serif !important;
        font-weight: 700 !important;
        font-size: 10px !important;
        letter-spacing: 0.5px !important;
    }
    .flatpickr-day {
        color: #e2e8f0 !important;
        font-weight: 500 !important;
        border-radius: 8px !important;
        border: 1px solid transparent !important;
        transition: all 0.2s ease !important;
        margin: 2px !important;
        height: 35px !important;
        line-height: 33px !important;
    }
    .flatpickr-day.prevMonthDay, .flatpickr-day.nextMonthDay {
        color: rgba(255, 255, 255, 0.25) !important;
    }
    .flatpickr-day.today {
        border-color: var(--accent) !important;
        color: var(--accent) !important;
        font-weight: bold !important;
    }
    .flatpickr-day.today:hover {
        background: var(--accent-dim) !important;
        color: var(--accent) !important;
    }
    .flatpickr-day:hover, .flatpickr-day.prevMonthDay:hover, .flatpickr-day.nextMonthDay:hover {
        background: var(--accent-dim) !important;
        color: var(--accent-teal) !important;
        border-color: var(--accent-border) !important;
    }
    .flatpickr-day.selected, .flatpickr-day.selected:hover,
    .flatpickr-day.startRange, .flatpickr-day.endRange {
        background: var(--accent) !important;
        color: #ffffff !important;
        font-weight: 800 !important;
        border-color: transparent !important;
    }
    .flatpickr-time {
        border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
        background: var(--bg-3) !important;
        border-radius: 0 0 12px 12px !important;
    }
    .flatpickr-time input {
        color: var(--accent-teal) !important;
        font-family: 'JetBrains Mono', monospace !important;
        font-weight: 700 !important;
        font-size: 14px !important;
    }
    .flatpickr-time .numInputWrapper span.arrowUp:after {
        border-bottom-color: #ffffff !important;
    }
    .flatpickr-time .numInputWrapper span.arrowDown:after {
        border-top-color: #ffffff !important;
    }
    .flatpickr-time input:hover, .flatpickr-time input:focus {
        background: rgba(255, 255, 255, 0.05) !important;
    }
    .flatpickr-time .flatpickr-time-separator {
        color: #ffffff !important;
    }
    .flatpickr-time .flatpickr-am-pm {
        color: #ffffff !important;
        font-family: 'Inter', sans-serif !important;
        font-weight: 700 !important;
    }


    /* Configuration section card header color */
    .cyber-card {
        background: var(--bg-2) !important;
        border: 1px solid var(--border) !important;
        border-radius: 10px;
    }
    .cyber-card:hover {
        border-color: #333333 !important;
    }

    /* Server Tabs Styles Overrides for Ultra Premium look */
    .server-tabs-container {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 16px;
    }
    
    .server-tab {
        background: var(--bg-3) !important;
        border: 1px solid var(--border) !important;
        border-radius: 8px !important;
        padding: 10px 20px !important;
        color: var(--text-muted) !important;
        cursor: pointer;
        font-family: 'Inter', sans-serif !important;
        font-weight: 700 !important;
        font-size: 0.85rem !important;
        letter-spacing: 0.5px;
        transition: all 0.2s ease !important;
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
        overflow: hidden;
    }
    
    .server-tab:hover {
        background: rgba(0, 240, 255, 0.05) !important;
        border-color: rgba(0, 240, 255, 0.4) !important;
        color: #ffffff !important;
        box-shadow: 0 0 12px rgba(0, 240, 255, 0.15) !important;
        transform: translateY(-1px);
    }
    
    .server-tab.active {
        background: rgba(0, 240, 255, 0.1) !important;
        border-color: #00f0ff !important;
        color: #00f0ff !important;
        box-shadow: 0 0 18px rgba(0, 240, 255, 0.25) !important;
        text-shadow: 0 0 5px rgba(0, 240, 255, 0.5);
    }
    
    .server-tab.active::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: #00f0ff;
        box-shadow: 0 0 10px #00f0ff;
    }
    
    .server-tab.add-tab {
        background: rgba(57, 255, 20, 0.02) !important;
        border: 1px dashed rgba(57, 255, 20, 0.3) !important;
        color: #39ff14 !important;
    }
    
    .server-tab.add-tab:hover {
        background: rgba(57, 255, 20, 0.08) !important;
        border-color: #39ff14 !important;
        color: #39ff14 !important;
        box-shadow: 0 0 15px rgba(57, 255, 20, 0.3) !important;
        transform: translateY(-1px);
    }
</style>

<div class="container-fluid">
    
    <!-- No Servers Warning -->
    <div class="row d-none" id="noServersWarning">
        <div class="col-12 text-center py-5">
            <div class="cyber-card rounded-lg p-8 inline-block max-w-lg">
                <span class="material-symbols-outlined text-[#ff0055] text-5xl mb-3 block" style="text-shadow: 0 0 10px rgba(255, 0, 85, 0.4);">warning</span>
                <h3 class="font-cyber-title text-lg font-bold text-white mb-2">Sin Servidores Configurados</h3>
                <p class="text-slate-300 mt-3 mb-6">Para iniciar, agrega un servidor de SmartFlow registrando su dirección IP o FQDN y tus credenciales de inicio de sesión.</p>
                <button class="flex items-center justify-center gap-1 mx-auto px-6 py-2.5 bg-[#00f0ff] text-slate-950 font-cyber-title text-[11px] font-bold rounded-md cyber-glow-primary hover:scale-[0.98] transition-transform" onclick="openAddServerModal()">
                    <span class="material-symbols-outlined text-[16px]">dns</span> Agregar Primer Servidor
                </button>
            </div>
        </div>
    </div>

    <!-- Main Dashboard Workspace -->
    <div id="dashboardWorkspace" class="d-none">
        <div class="grid grid-cols-12 gap-6">
        
        <!-- Left Side: Config & Bulk Forms -->
        <div class="col-span-12 lg:col-span-8 space-y-6">
            
            <!-- Server Tabs (Dynamic Server Switcher) -->
            <div class="server-tabs-container mb-4" id="serverTabs">
                <button class="server-tab add-tab" onclick="openAddServerModal()">
                    <span class="material-symbols-outlined">add_circle</span> Agregar Servidor
                </button>
            </div>

            <!-- Configuration Section -->
            <div class="cyber-card rounded-lg p-6">
                <div class="flex items-center gap-2 mb-6">
                    <span class="material-symbols-outlined text-[#bc34fa] text-[24px]">settings_input_component</span>
                    <h3 class="font-cyber-title text-base font-bold text-[#bc34fa] tracking-wider uppercase" style="text-shadow: 0 0 5px rgba(188, 52, 250, 0.3);">Configuración de Acarreos</h3>
                </div>

                <form id="botConfigForm">
                    <div class="grid grid-cols-4 gap-4 mb-8">
                        <div>
                            <label class="font-cyber-title text-[10px] text-slate-400 font-bold block mb-2">PORCENTAJE MÍNIMO</label>
                            <div class="relative">
                                <input class="w-full cyber-input px-3 py-2 pr-8 rounded" type="number" id="tonnageMin" value="80" required>
                                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[12px] text-slate-400 font-mono">%</span>
                            </div>
                        </div>
                        <div>
                            <label class="font-cyber-title text-[10px] text-slate-400 font-bold block mb-2">PORCENTAJE MÁXIMO</label>
                            <div class="relative">
                                <input class="w-full cyber-input px-3 py-2 pr-8 rounded" type="number" id="tonnageMax" value="110" required>
                                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[12px] text-slate-400 font-mono">%</span>
                            </div>
                        </div>
                        <div>
                            <label class="font-cyber-title text-[10px] text-slate-400 font-bold block mb-2">TIEMPO MÍN (MIN)</label>
                            <input class="w-full cyber-input px-3 py-2 rounded" type="number" id="timeMin" value="5" min="1" required>
                        </div>
                        <div>
                            <label class="font-cyber-title text-[10px] text-slate-400 font-bold block mb-2">TIEMPO MÁX (MIN)</label>
                            <input class="w-full cyber-input px-3 py-2 rounded" type="number" id="timeMax" value="15" min="1" required>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-x-6 gap-y-2">
                        <!-- Row 1: Headers -->
                        <div class="flex justify-between items-end">
                            <label class="font-cyber-title text-[11px] text-[#00f0ff] font-bold">RUTAS ACTIVAS</label>
                            <div class="flex gap-2">
                                <button type="button" class="text-[9px] text-[#00f0ff] underline font-bold" onclick="toggleSelectAll('routesList', true)">Todos</button>
                                <button type="button" class="text-[9px] text-slate-400 underline" onclick="toggleSelectAll('routesList', false)">Ninguno</button>
                            </div>
                        </div>
                        <div class="flex justify-between items-end">
                            <label class="font-cyber-title text-[11px] text-[#00f0ff] font-bold">OPERADORES ACTIVOS</label>
                            <div class="flex gap-2">
                                <button type="button" class="text-[9px] text-[#00f0ff] underline font-bold" onclick="toggleSelectAll('employeesList', true)">Todos</button>
                                <button type="button" class="text-[9px] text-slate-400 underline" onclick="toggleSelectAll('employeesList', false)">Ninguno</button>
                            </div>
                        </div>
                        <div class="flex justify-between items-end">
                            <label class="font-cyber-title text-[11px] text-[#00f0ff] font-bold">VEHÍCULOS ACTIVOS</label>
                            <div class="flex gap-2">
                                <button type="button" class="text-[9px] text-[#00f0ff] underline font-bold" onclick="toggleSelectAll('vehiclesList', true)">Todos</button>
                                <button type="button" class="text-[9px] text-slate-400 underline" onclick="toggleSelectAll('vehiclesList', false)">Ninguno</button>
                            </div>
                        </div>

                        <!-- Row 2: Search Inputs -->
                        <div class="relative">
                            <input type="text" class="w-full cyber-input text-[11px] pl-3 pr-7 py-1.5 rounded" placeholder="Filtrar rutas..." id="searchRoutes">
                            <button type="button" class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white d-none transition-colors" id="btnClearSearchRoutes" onclick="clearSearchInput('searchRoutes', 'btnClearSearchRoutes')">
                                <span class="material-symbols-outlined text-[14px]">close</span>
                            </button>
                        </div>
                        <div class="relative">
                            <input type="text" class="w-full cyber-input text-[11px] pl-3 pr-7 py-1.5 rounded" placeholder="Filtrar operadores..." id="searchEmployees">
                            <button type="button" class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white d-none transition-colors" id="btnClearSearchEmployees" onclick="clearSearchInput('searchEmployees', 'btnClearSearchEmployees')">
                                <span class="material-symbols-outlined text-[14px]">close</span>
                            </button>
                        </div>
                        <div class="relative">
                            <input type="text" class="w-full cyber-input text-[11px] pl-3 pr-7 py-1.5 rounded" placeholder="Filtrar vehículos..." id="searchVehicles">
                            <button type="button" class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white d-none transition-colors" id="btnClearSearchVehicles" onclick="clearSearchInput('searchVehicles', 'btnClearSearchVehicles')">
                                <span class="material-symbols-outlined text-[14px]">close</span>
                            </button>
                        </div>

                        <!-- Row 3: Material Filters / Spacers -->
                        <div class="flex gap-1 flex-wrap items-center mt-1" id="routeMaterialFilter">
                            <button type="button" class="route-mat-btn active text-[9px] px-2 py-0.5 rounded font-bold" data-mat="all" onclick="filterRoutesByMaterial('all')">TODOS</button>
                            <button type="button" class="route-mat-btn text-[9px] px-2 py-0.5 rounded font-bold" data-mat="1" onclick="filterRoutesByMaterial(1)">MINERAL</button>
                            <button type="button" class="route-mat-btn text-[9px] px-2 py-0.5 rounded font-bold" data-mat="2" onclick="filterRoutesByMaterial(2)">ESTÉRIL</button>
                            <button type="button" class="route-mat-btn text-[9px] px-2 py-0.5 rounded font-bold" data-mat="3" onclick="filterRoutesByMaterial(3)">AMBOS</button>
                        </div>
                        <div></div>
                        <div></div>
 
                        <!-- Row 4: Lists -->
                        <div class="bg-black/40 border border-slate-900/60 rounded-lg h-40 overflow-y-auto terminal-scroll p-2 space-y-1 mt-1" id="routesList">
                            <span class="text-slate-500 text-xs">Cargando rutas...</span>
                        </div>
                        <div class="bg-black/40 border border-slate-900/60 rounded-lg h-40 overflow-y-auto terminal-scroll p-2 space-y-1 mt-1" id="employeesList">
                            <span class="text-slate-500 text-xs">Cargando operadores...</span>
                        </div>
                        <div class="bg-black/40 border border-slate-900/60 rounded-lg h-40 overflow-y-auto terminal-scroll p-2 space-y-1 mt-1" id="vehiclesList">
                            <span class="text-slate-500 text-xs">Cargando vehículos...</span>
                        </div>

                        <!-- Row 5: Counters -->
                        <div class="text-slate-400 font-mono text-[10px] mt-1 text-right font-bold" id="routesCounter">
                            0 de 0 seleccionados
                        </div>
                        <div class="text-slate-400 font-mono text-[10px] mt-1 text-right font-bold" id="employeesCounter">
                            0 de 0 seleccionados
                        </div>
                        <div class="text-slate-400 font-mono text-[10px] mt-1 text-right font-bold" id="vehiclesCounter">
                            0 de 0 seleccionados
                        </div>
                    </div>

                    <div class="mt-8 flex justify-end">
                        <button type="submit" class="flex items-center gap-2 px-8 py-3 bg-purple-600/10 border border-purple-500/20 text-purple-400 hover:bg-purple-600 hover:text-white hover:border-purple-600 font-cyber-title text-[12px] font-bold rounded-md transition-all">
                            <span class="material-symbols-outlined text-[18px]">save</span>
                            GUARDAR CONFIGURACIÓN
                        </button>
                    </div>
                </form>
            </div>

            <!-- Bulk Generation Form -->
            <div class="cyber-card rounded-lg p-6">
                <div class="flex items-center gap-2 mb-6">
                    <span class="material-symbols-outlined text-[#ff0055] text-[24px]">date_range</span>
                    <h3 class="font-cyber-title text-base font-bold text-[#ff0055] tracking-wider uppercase" style="text-shadow: 0 0 5px rgba(255, 0, 85, 0.3);">GENERACIÓN MASIVA REALISTA</h3>
                </div>

                <form id="bulkGenerateForm">
